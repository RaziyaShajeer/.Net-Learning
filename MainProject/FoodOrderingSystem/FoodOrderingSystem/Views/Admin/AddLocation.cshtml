
<head>
    
    <style>
        

        .addlocation {
            max-width: 500px;
            width: 100%;
            padding: 20px;
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.3);
        }

        .btn-custom {
            background-color: #432119;
            color: white;
            border: none;
        }

            .btn-custom:hover {
                background-color: #6a3e1d;
            }
    </style>
</head>
<body>
    <div class="container-fluid" style="background: url('https://images.unsplash.com/photo-1600891964599-f61ba0e24092') no-repeat center center/cover;height:85vh">

    <div class="container addlocation">
        <h2 class="text-center mb-4">Location</h2>
        <form id="Location" asp-action="AddLocation">

            <div class="mb-3">
                    <label for="LocationName" class="form-label">Location</label>
                    <input name="LocationName" type="text" class="form-control" id="LocationName" placeholder="Enter your location">
            </div>

            <div class="text-center">
                <button type="submit" class="btn btn-custom w-75 mt-2">Add</button>
            </div>
        </form>
    </div>

</body>
</html>
