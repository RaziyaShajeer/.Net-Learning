@model IEnumerable<FoodOrderingSystem.Models.Cartitem>

@{
    ViewData["Title"] = "Checkout";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var grandTotal = Model?.Sum(x => x.Total) ?? 0;
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h2 class="fw-bold">🛍️ Checkout</h2>
        <p class="text-muted">Complete your order in just one step</p>
    </div>

    <div class="row g-4">

        <!-- Order Summary -->
        <div class="col-lg-7">

            <div class="card shadow border-0 rounded-4">

                <div class="card-header bg-dark text-white rounded-top-4">
                    <h5 class="mb-0">
                        🧾 Order Summary
                    </h5>
                </div>

                <div class="card-body">

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <div class="d-flex align-items-center justify-content-between border-bottom pb-3 mb-3">

                                <div class="d-flex align-items-center">

                                    <img src="@Url.Content("~/" + item.Dish.DishImagePath)"
                                         class="rounded shadow-sm me-3"
                                         style="width:70px;height:70px;object-fit:cover;" />

                                    <div>
                                        <h6 class="fw-bold mb-1">
                                            @item.Dish.DishName
                                        </h6>

                                        <small class="text-muted">
                                            Quantity : @item.Quanity
                                        </small>
                                    </div>

                                </div>

                                <div class="text-end">

                                    <div class="fw-bold text-success">
                                        ₹ @item.Total
                                    </div>

                                    <small class="text-muted">
                                        ₹ @item.Price each
                                    </small>

                                </div>

                            </div>
                        }

                        <div class="d-flex justify-content-between mt-4">

                            <h4 class="fw-bold">
                                Grand Total
                            </h4>

                            <h3 class="text-success fw-bold">
                                ₹ @grandTotal
                            </h3>

                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            Your cart is empty.
                        </div>
                    }

                </div>

            </div>

        </div>

        <!-- Payment -->
        <div class="col-lg-5">

            <div class="card shadow-lg border-0 rounded-4 sticky-top"
                 style="top:90px;">

                <div class="card-header bg-success text-white rounded-top-4">
                    <h5 class="mb-0">
                        🚚 Delivery Details
                    </h5>
                </div>

                <div class="card-body">

                    <form asp-action="PlaceOrder" method="post">

                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                📍 Delivery Address
                            </label>

                            <textarea class="form-control"
                                      name="Address"
                                      rows="4"
                                      placeholder="Enter your delivery address..."
                                      required></textarea>

                        </div>

                        <div class="mb-4">

                            <label class="fw-semibold mb-3">
                                💳 Select Payment Method
                            </label>

                            <div class="card mb-2 p-3">

                                <div class="form-check">

                                    <input class="form-check-input"
                                           type="radio"
                                           name="PaymentMethod"
                                           value="COD"
                                           checked>

                                    <label class="form-check-label fw-semibold">
                                        Cash on Delivery
                                    </label>

                                </div>

                            </div>

                            <div class="card p-3">

                                <div class="form-check">

                                    <input class="form-check-input"
                                           type="radio"
                                           name="PaymentMethod"
                                           value="Online">

                                    <label class="form-check-label fw-semibold">
                                        Online Payment
                                    </label>

                                </div>

                            </div>

                        </div>

                        <div class="bg-light rounded p-3 mb-4">

                            <div class="d-flex justify-content-between">

                                <span>Total Amount</span>

                                <span class="fw-bold text-success fs-4">
                                    ₹ @grandTotal
                                </span>

                            </div>

                        </div>

                        <button class="btn btn-success btn-lg w-100">

                            ✅ Place Order

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>