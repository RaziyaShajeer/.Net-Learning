@model IEnumerable<FoodOrderingSystem.Models.Cartitem>

@{
    ViewData["Title"] = "My Cart";
    var grandTotal = Model != null && Model.Any() ? Model.Sum(x => x.Total) : 0;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">

    <div class="text-center mb-4">
        <h2 class="fw-bold">🛒 My Cart</h2>
        <p class="text-muted">Review your items before checkout</p>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center shadow-sm">
            Your cart is empty.
        </div>
    }
    else
    {
        <div class="card shadow-lg border-0">
            <div class="card-body">

                <div class="table-responsive">
                    <table class="table align-middle text-center">
                        <thead class="table-dark">
                            <tr>
                                <th class="text-start">Dish</th>
                                <th>Price</th>
                                <th>Quantity</th>
                                <th>Total</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-start fw-semibold">
                                        @item.Dish?.DishName
                                    </td>

                                    <td>₹ @item.Price</td>

                                    <td>
                                        <button class="btn btn-outline-danger btn-sm"
                                                onclick="updateQty('@item.CartItemId', 'decrease')">
                                            −
                                        </button>

                                        <span id="qty-@item.CartItemId">@item.Quanity</span>

                                        <button class="btn btn-outline-success btn-sm"
                                                onclick="updateQty('@item.CartItemId', 'increase')">
                                            +
                                        </button>
                                    </td>

                                    <td class="fw-bold text-success">
                                        ₹ <span id="total-@item.CartItemId">@item.Total</span>
                                    </td>

                                  

                                    <td>
                                        <button class="btn btn-danger btn-sm"
                                                onclick="removeItem('@item.CartItemId')">
                                            Remove
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <hr />

                <div class="d-flex justify-content-between align-items-center flex-wrap">
                    <h4 class="fw-bold">
                        Grand Total:
                        <span class="text-primary">
                            ₹ <span id="grandTotal">@grandTotal</span>
                        </span>
                    </h4>

                    <button class="btn btn-danger btn-sm"
                            onclick="ProceedToCheckOut()">
                        ProceedToCheckOut
                    </button>
                </div>

            </div>
        </div>
    }
</div>
@section Scripts {
    <script>
           // function updateQty(id, actionType) {

           //  fetch(`/Cart/UpdateQuantity?id=${id}&actionType=${actionType}`, {
           //      method: 'POST'
           //  })
           //  .then(response => response.json())
           //  .then(data => {

           //      if (data.removed) {
           //          location.reload();
           //          return;
           //      }

           //      if (data.success) {
           //          document.getElementById("qty-" + id).innerText = data.quantity;
           //          document.getElementById("total-" + id).innerText = data.total;
           //          document.getElementById("grandTotal").innerText = data.grandTotal;
           //      }

           //  });
          function updateQty(id, actionType) {

            fetch(`/User/Cart/UpdateQuantity?id=${id}&actionType=${actionType}`, {
                method: 'POST'
            })
            .then(response => response.json())
            .then(data => {

                if (data.removed) {
                    location.reload();
                    return;
                }

                if (data.success) {

                    // Update quantity
                    document.getElementById("qty-" + id).innerText = data.quantity;

                    // Update item total
                    document.getElementById("total-" + id).innerText = data.total;

                    // Update grand total
                    document.getElementById("grandTotal").innerText = data.grandTotal;
                }

            })
            .catch(error => console.error(error));
        }
                
        function removeItem(id) {

            fetch(`/User/Cart/Remove?id=${id}`, {
                method: 'POST'
            })
            .then(response => response.json())
            .then(data => {

                if (data.success) {
                    location.reload();
                }

            });
        } function ProceedToCheckOut() {
       
            window.location.href = '@Url.Action("Checkout", "Cart")';
        }
        


    </script>
}