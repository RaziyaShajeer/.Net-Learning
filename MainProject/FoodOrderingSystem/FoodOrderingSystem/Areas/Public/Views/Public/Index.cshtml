@model List<FoodOrderingSystem.Models.RestaurantProfile>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .hero {
        /* background: url('https://images.unsplash.com/photo-1600891964599-f61ba0e24092') no-repeat center center/cover; */
        background: url('@Url.Content("~/images/background.jpeg")') no-repeat center center/cover;
        height: 90vh;
        color: white;
        position: relative;
    }

    .hero-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.6);
    }

    .restaurant-img {
        width: 100%; /* image spans full width of card */
        height: 200px; /* fixed uniform height for all images */
        object-fit: cover; /* crops instead of stretching */
    }
    .hero-content {
        position: relative;
        z-index: 2;
        text-align: center;
        top: 35%;
    }

    .category-card img {
        height: 150px;
        object-fit: cover;

    }
</style>



<div class="row">
    <section class="hero d-flex align-items-center">
        <div class="hero-overlay"></div>
        <div class="container hero-content">
            <h1 class="display-4">Delicious food delivered to you</h1>
            <p class="lead">Explore your nearest restaurants and favorite dishes</p>
            <form asp-action="searchRestaurant" asp-controller="Public" asp-area="Public" method="get" class="d-flex justify-content-center mt-4">
                <input type="text" name="value" class="form-control w-50 rounded-0" placeholder="Search for food or restaurants">
                <button type="submit" class="btn btn-warning rounded-0">Search</button>
            </form>
        </div>
    </section>
</div>
<!-- Categories Section -->
<section class="py-5 bg-light">
    <div class="container">
        <h2 class="mb-4 text-center">Browse by Category</h2>
        <div class="row g-4">
            <div class="col-md-3 col-sm-6">
                <div class="card category-card">
                    <img src="@Url.Content("~/images/seafood.jpg")" class="card-img-top" alt="seafood" style="height:180px;object-fit:cover;">

                    <div class="card-body text-center">
                        <h5 class="card-title">Sea Food</h5>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="card category-card">
                    <img src="@Url.Content("~/images/chinees.jpg")" class="card-img-top" alt="chinees" style="height:180px;object-fit:cover;">
                    <div class="card-body text-center">
                        <h5 class="card-title">Chinees</h5>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="card category-card">
                    <img src="@Url.Content("~/images/salad.jpg")" class="card-img-top" alt="salad" style="height:180px;object-fit:cover;">
                    <div class="card-body text-center">
                        <h5 class="card-title">Salad</h5>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="card category-card">
                    <img src="@Url.Content("~/images/desert.jpg")" class="card-img-top" alt="desert" style="height:180px;object-fit:cover;">
                    <div class="card-body text-center">
                        <h5 class="card-title">Desserts</h5>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Popular Restaurants -->
<section class="py-5 bg-light">
    <div class="container">
        <h2 class="mb-4 text-center">Popular Restaurants</h2>
        <div class="row g-4">
            @foreach (var r in Model)
            {
                <div class="col-md-4 col-sm-6">
                    <div class="card h-100">
                        <img src="@Url.Content("~/" + r.RestaurantImagesPath)"
                             class="card-img-top restaurant-img"
                             alt="@r.RestaurantName" />

                        <div class="card-body text-center">
                            <h5 class="card-title">@r.RestaurantName</h5>
                            <p class="card-text">⭐ @r.RestauratType </p>
                            <p class="text-muted">@r.LocationName</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
<!-- Footer -->
