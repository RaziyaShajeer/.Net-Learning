

<head>

    <style>


        .addlocation {
            max-width: 500px;
            width: 100%;
            padding: 20px;
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.3);
        }

        .btn-custom {
            background-color: #432119;
            color: white;
            border: none;
        }

            .btn-custom:hover {
                background-color: #6a3e1d;
            }
    </style>
</head>
<body>
    <div class="container-fluid" style="background: url('https://images.unsplash.com/photo-1600891964599-f61ba0e24092') no-repeat center center/cover;height:85vh">

        <div class="container addlocation">
            <h2 class="text-center mb-4">Category</h2>
            <form id="Location" asp-action="AddCategory">

                <div class="mb-3">
                    <label for="Name" class="form-label">Location</label>
                    <input name="Name" type="text" class="form-control" id="Name" placeholder="Enter your location">
                </div>
                <div class="mb-3">
                    <label asp-for="CategoryImage" class="form-label fw-semibold"></label>
                    <input asp-for="CategoryImage" type="file" class="form-control rounded-pill" />
                    <span asp-validation-for="CategoryImage" class="text-danger small"></span>
                </div>

                <div class="text-center">
                    <button type="submit" class="btn btn-custom w-75 mt-2">Add</button>
                </div>
            </form>
        </div>
        </div>
</body>


