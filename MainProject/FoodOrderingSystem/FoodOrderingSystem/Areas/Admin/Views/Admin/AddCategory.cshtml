@model FoodOrderingSystem.DTO.CategoryDto
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="card add-category-card shadow-lg border-0 rounded-5 mx-auto">
        <div class="card-body p-5">

            <h2 class="text-center fw-bold text-gradient mb-4">
                <i class="bi bi-plus-circle-dotted me-2"></i> Add New Category
            </h2>
            <hr class="mb-4" />

            <form asp-action="AddCategory" asp-controller="Admin" asp-area="Admin" enctype="multipart/form-data" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Category Name -->
                <div class="mb-4">
                    <label asp-for="CategoryName" class="form-label fw-semibold text-muted">
                        <i class="bi bi-tag-fill me-1 text-success"></i> Category Name
                    </label>
                    <input asp-for="CategoryName"
                           class="form-control form-control-lg rounded-4 shadow-sm"
                           placeholder="Enter category name" name="CategoryName" />
                    <span asp-validation-for="CategoryName" class="text-danger small"></span>
                </div>

                <!-- Category Image -->
                <div class="text-center mb-4">
                    <label class="form-label fw-semibold text-muted d-block mb-3">
                        <i class="bi bi-image-fill me-1 text-success"></i> Category Image
                    </label>

                    <div class="image-upload-container position-relative d-inline-block">
                        <img id="imagePreview"
                             src="~/images/default-doctor.png"
                             alt="Upload Category"
                             class="preview-img rounded-circle border border-4 border-light shadow-sm" />
                        <div class="image-overlay">
                            <i class="bi bi-cloud-arrow-up fs-4"></i>
                            <span>Upload</span>
                        </div>
                    </div>

                    <input asp-for="CategoryImage"
                           type="file"
                           id="CategoryImageInput"
                           name="CategoryImage"
                           accept="image/*"
                           class="d-none" />

                    <span asp-validation-for="CategoryImage" class="text-danger small d-block mt-2"></span>
                </div>

                <!-- Submit Button -->
                <div class="text-center mt-5">
                    <button type="submit" class="btn btn-gradient btn-lg px-5 py-2 rounded-pill shadow-sm">
                        <i class="bi bi-check2-circle me-2"></i> Create Category
                    </button>
                </div>
            </form>

            <div class="text-center mt-4">
                <a asp-action="Index" class="text-secondary fw-semibold hover-underline">
                    <i class="bi bi-arrow-left-circle me-1"></i> Back to List
                </a>
            </div>
        </div>
    </div>
</div>

<!-- ✅ Styles -->
<style>
    /* Gradient Text */
    .text-gradient {
        background: linear-gradient(90deg, #28a745, #17a2b8, #6f42c1);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: gradientMove 5s ease infinite;
        background-size: 200% auto;
    }

  
        

   

    /* Card */
    .add-category-card {
        max-width: 600px;
        border-radius: 25px;
        background: linear-gradient(145deg, #ffffff, #f8f9fa);
        transition: all 0.3s ease;
    }

        .add-category-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15);
        }

    /* Input focus glow */
    .form-control:focus {
        border-color: #198754;
        box-shadow: 0 0 12px rgba(25, 135, 84, 0.4);
    }

    /* Image Upload */
    .image-upload-container {
        width: 170px;
        height: 170px;
        border-radius: 50%;
        overflow: hidden;
        position: relative;
        cursor: pointer;
    }

    .preview-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: 0.4s ease;
    }

    .image-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border-radius: 50%;
        background: rgba(0, 0, 0, 0.55);
        color: white;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        font-weight: 500;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .image-upload-container:hover .image-overlay {
        opacity: 1;
    }

    .image-upload-container:hover .preview-img {
        filter: brightness(0.75);
        transform: scale(1.05);
    }

    /* Gradient Button */
    .btn-gradient {
        background: linear-gradient(90deg, #28a745, #17a2b8);
        color: white;
        border: none;
        transition: all 0.3s ease;
    }

        .btn-gradient:hover {
            background: linear-gradient(90deg, #17a2b8, #6f42c1);
            box-shadow: 0 0 20px rgba(111, 66, 193, 0.5);
            transform: translateY(-2px);
        }

    /* Link Hover */
    .hover-underline:hover {
        text-decoration: underline;
        color: #198754;
    }
</style>

<!-- ✅ Image Preview Script -->
<script>
    const input = document.getElementById("CategoryImageInput");
    const preview = document.getElementById("imagePreview");

    document.querySelector('.image-upload-container').addEventListener('click', () => {
        input.click();
    });

    input.addEventListener("change", (e) => {
        const file = e.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = (ev) => preview.src = ev.target.result;
            reader.readAsDataURL(file);
        }
    });
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
