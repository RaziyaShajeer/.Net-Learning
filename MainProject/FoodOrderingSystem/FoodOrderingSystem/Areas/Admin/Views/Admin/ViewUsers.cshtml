@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@model IEnumerable<FoodOrderingSystem.Models.MyUser>

@{
    ViewData["Title"] = "ViewUsers";
    Layout = "~/areas/Admin/Views/Shared/_AdminDashboard.cshtml";

}


<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    .user-card {
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
        text-align: center;
        background-color: #fff;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
    }

        .user-card img {
            width: 60px;
            height: 60px;
            object-fit: cover;
            border-radius: 50%;
            margin-bottom: 10px;
        }

    .card-buttons a {
        margin: 0 4px;
    }
</style>

<h3 class="text-center mb-4">Users</h3>

<div class="container">
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3">
        @foreach (var user in Model)
        {
            <div class="col">
                <div class="user-card">
                    <img src="https://cdn-icons-png.flaticon.com/512/847/847969.png" alt="User Icon" />
                    <h5 class="card-title">@user.FirstName @user.Lastname</h5>
                    <p class="card-text mb-1"><strong>Email:</strong> @user.Email</p>
                    <p class="card-text mb-1"><strong>Phone:</strong> @user.Phone</p>
                    <p class="card-text mb-1"><strong>Address:</strong> @user.Address</p>
                    <p class="card-text mb-1"><strong>State:</strong> @user.State</p>
                    <p class="card-text mb-1"><strong>Role:</strong> @user.Role</p>
                    <p class="card-text mb-1"><strong>Created:</strong> @user.CreatedAt.ToString("yyyy-MM-dd")</p>
                    <p class="card-text"><strong>Location ID:</strong> @user.Location.LocationName</p>


                    <div class="card-buttons mt-2">
                        <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@user.UserId">Edit</a>
                        <a class="btn btn-sm btn-info text-white" asp-action="Details" asp-route-id="@user.UserId">Details</a>
                        <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@user.UserId">Delete</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>


