@model FoodOrderingSystem.DTO.DishDTO
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Add Dish";

    if (Context.Session.GetString("Role") == "HotelManager")
    {
        Layout = "/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    }
    else
    {
        Layout = "_Layout";
    }
}

<div class="container mt-5 mb-5">
    <p>Category Count: @(Model.categoryList?.Count() ?? 0)</p>
    <p>DishType Count: @(Model.dishTypelist?.Count() ?? 0)</p>
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-primary text-white text-center py-3 rounded-top-4">
            <h3 class="mb-0"><i class="bi bi-plus-circle"></i> Add New Dish</h3>
        </div>

        <div class="card-body px-5 py-4">
            <form asp-action="AddDish" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Dish Name -->
                <div class="mb-3">
                    <label asp-for="DishName" class="form-label fw-semibold"></label>
                    <input asp-for="DishName" name="DishName" class="form-control" placeholder="Enter dish name" />
                    <span asp-validation-for="DishName" class="text-danger"></span>
                </div>

                <!-- Description -->
                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold"></label>
                    <textarea asp-for="Description" name="Description" class="form-control" rows="3" placeholder="Enter a short description"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <!-- Category -->
                <div class="mb-3">
                    <label asp-for="CategoryId" class="control-label fw-bold"></label>
                    <select asp-for="CategoryId"
                            class="form-control"
                            asp-items="Model.categoryList">
                        <option value="">-- Select Category --</option>
                    </select>


                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="DishType" class="control-label fw-bold"></label>
                    <select asp-for="DishType"
                            class="form-control"
                            asp-items="Model.dishTypelist">
                        <option value="">-- Select Type --</option>
                    </select>


                    <span asp-validation-for="DishType" class="text-danger"></span>
                </div>

                <!-- Price -->
                <div class="mb-3">
                    <label asp-for="Price" class="form-label fw-semibold"></label>
                    <input asp-for="Price" name="Price" class="form-control" placeholder="Enter price" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

               <div class="mb-3">
                    <label asp-for="DishImageFile" class="form-label fw-semibold"></label>
                    <input asp-for="DishImageFile" name="DishImageFile" type="file" class="form-control" placeholder="Enter Dish image" />
                    <span asp-validation-for="DishImageFile" class="text-danger"></span>
               </div>

                <!-- Submit -->
                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Back to List
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle"></i> Create Dish
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
