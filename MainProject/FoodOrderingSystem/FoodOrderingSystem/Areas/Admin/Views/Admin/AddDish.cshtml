@model FoodOrderingSystem.DTO.DishDTO
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Add Dish";
    Layout = "~/Areas/Admin/Views/Shared/_HotelMngrDashboard.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

<style>
    .form-card {
        border: none;
        border-radius: 1.5rem;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.1);
        background-color: #ffffff;
    }

    .form-card-header {
        background: linear-gradient(to right, #0d6efd, #6610f2);
        color: white;
        padding: 1rem;
        border-top-left-radius: 1.5rem;
        border-top-right-radius: 1.5rem;
        text-align: center;
    }

    .form-label {
        font-weight: 600;
    }

    .btn-lg {
        font-size: 1.1rem;
    }

    .back-link i {
        vertical-align: middle;
    }

    .back-link {
        text-decoration: none;
        color: #0d6efd;
        font-weight: 500;
    }

    .back-link:hover {
        text-decoration: underline;
    }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card form-card">
                <div class="form-card-header">
                    <h3 class="mb-0"><i class="bi bi-plus-circle-dotted me-2"></i> Add New Dish</h3>
                </div>
                <div class="card-body px-4">
                    <form asp-action="AddDish" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="DishName" class="form-control" placeholder="Dish Name" />
                            <label asp-for="DishName"></label>
                            <span asp-validation-for="DishName" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Description" class="form-control" placeholder="Description" />
                            <label asp-for="Description"></label>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Category" class="form-label"></label>
                            <select asp-for="Category" class="form-select" asp-items="Model.CategoryList">
                                <option value="">-- Select Category --</option>
                            </select>
                            <span asp-validation-for="Category" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Price" class="form-control" placeholder="Price" />
                            <label asp-for="Price"></label>
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="DishImageFile" class="form-label" data-bs-toggle="tooltip" title="Upload an image for the dish"></label>
                            <input asp-for="DishImageFile" type="file" class="form-control" />
                            <span asp-validation-for="DishImageFile" class="text-danger small"></span>
                        </div>

                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-success btn-lg rounded-pill">
                                <i class="bi bi-check2-circle me-1"></i> Save Dish
                            </button>
                        </div>
                    </form>
                </div>
                <div class="card-footer text-center bg-light border-0 rounded-bottom-4 py-3">
                    <a class="back-link" asp-area="Admin" asp-controller="Admin" asp-action="ViewDish">
                        <i class="bi bi-arrow-left-circle me-1"></i> Back to Dish List
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

