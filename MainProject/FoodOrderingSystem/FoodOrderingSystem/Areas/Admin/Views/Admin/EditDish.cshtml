@model FoodOrderingSystem.DTO.EditViewDishDTO
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var list = ViewBag.categories as SelectList;
}


<div class="row">

    <div class="col-md-6 offset-md-3">
        <form asp-action="EditDish" enctype="multipart/form-data" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="DishId"  />

            <!-- Doctor Image (clickable) -->
            <div class="form-group text-center mb-4">
                <label for="DishImage" class="form-label fw-semibold d-block">Dish Image</label>

                <label for="DishImage" style="cursor:pointer;">
                    @if (!string.IsNullOrEmpty(Model.DishImagePath))
                    {
                        <img src="@Url.Content("~/" + Model.DishImagePath)"
                        alt="@Model.DishName"
                        class="rounded-circle border shadow-sm"
                        style="width:150px; height:150px; object-fit:cover;" />
                    }
                    else
                    {
                        <img src="~/images/default-doctor.png"
                        alt="Upload Doctor"
                        class="rounded-circle border shadow-sm"
                        style="width:150px; height:150px; object-fit:cover;" />
                    }
                </label>

                <input asp-for="Image" type="file" id="DishImage" name="DishImage"
                class="d-none" accept="image/*" />
                <span asp-validation-for="Image" class="text-danger small"></span>
            </div>

            <!-- Doctor Details -->
            <div class="form-group mb-3">
                <label asp-for="DishName" class="control-label"></label>
                <input asp-for="DishName" class="form-control" value="@Model.DishName" name="DishName" />
                
                <span asp-validation-for="DishName" class="text-danger"></span>
            </div>

            <!-- Department -->

            <div>
                <label for="CategoryId" class="form-label fw-semibold">Category</label>
                <select id="CategoryId" name="Id" class="form-select">
                    <option value="">-- Choose a Category --</option>
                    @foreach (var item in (List<SelectListItem>)ViewBag.categories)
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>
            @if(Model.availablityList!=null)
            {
                <p>Model.availablityList.Count</p>
            }
            <div class="form-group">
                <label asp-for="Availablity" class="control-label "></label>
                <select asp-for="Availablity" class="form-control" asp-items="Model.availablityList" name="Availablity">
                    <option value="">-- Select Type --</option>
                </select>


                <span asp-validation-for="Availablity" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DishType" class="control-label "></label>
                <select asp-for="DishType" class="form-control" asp-items="Model.DishtypeList" name="DishType">
                    <option value="">-- Select Type --</option>
                </select>


                <span asp-validation-for="Availablity" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="RestaurantName" class="control-label"></label>
                <input asp-for="RestaurantName" class="form-control" name="RestaurantName"  value="@Model.RestaurantName"/>
                <span asp-validation-for="RestaurantName" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" name="Description"  value="@Model.Description"/>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Price" class="control-label"></label>
                <input asp-for="Price" class="form-control" name="Price"  value="@Model.Price"/>
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>


       
           

         

            <div class="form-group text-center">
                <input type="submit" value="Save" class="btn btn-primary px-4 rounded-pill" />
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill ms-2">Back to List</a>
            </div>
          </form>

    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
<!-- ✅ Custom Styling -->
<style>
    /* Card & Input Effects */
    .form-control:focus {
        box-shadow: 0 0 8px rgba(13, 110, 253, 0.4);
        border-color: #0d6efd;
    }

    /* Image Hover Overlay */
    label[for="CategoryImageInput"]:hover img {
        filter: brightness(0.8);
    }

    label[for="CategoryImageInput"]:hover .overlay {
        opacity: 1;
        cursor: pointer;
    }

    /* Glow on Save Button */
    .hover-glow:hover {
        box-shadow: 0 0 15px rgba(13, 110, 253, 0.6);
        transform: translateY(-2px);
        transition: 0.3s ease-in-out;
    }
</style>

@section Scripts {
    <script>
        // Instant image preview when a new file is selected
        document.getElementById("DishImage").addEventListener("change", function (e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (ev) {
                    const img = document.querySelector("label[for='DishImage'] img");
                    img.src = ev.target.result;
                };
                reader.readAsDataURL(file);
            }
        });
    </script>
}