@model FoodOrderingSystem.DTO.RestaurentProfileDTO
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

 


@{
    ViewData["Title"] = "AddRestaurant";
    Layout = "~/Views/Shared/_Layout.cshtml";

}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />


<h1 class="p-3">AddRestaurant</h1>


<hr />
<div class="container p-3 ">
<div class="row d-flex justify-content-center">
    <div class="col-md-5">
            <form asp-action="AddRestaurant" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group">
                    <label asp-for="RestaurantName" class="control-label fw-bold"></label>
                    <input asp-for="RestaurantName" class="form-control" name="RestaurantName" />
                <span asp-validation-for="RestaurantName" class="text-danger"></span>
            </div>
            <div class="form-group"> 
                   <label asp-for="RestauratType" class="control-label fw-bold"></label>
                    <select asp-for="RestauratType" class="form-control" asp-items="Model.restauranttype" name="RestauratType">
                    <option value="">-- Select Type --</option>
                    </select>


                    <span asp-validation-for="RestauratType" class="text-danger"></span>
                 </div>
      
            <div class="form-group">
                    <label asp-for="Phone" class="control-label fw-bold"></label>
                    <input asp-for="Phone" class="form-control" name="Phone" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>
            <div class="form-group">
                    <label asp-for="LocationName" class="control-label fw-bold"></label>
                    <input asp-for="LocationName" class="form-control" name="LocationName" />
                    <span asp-validation-for="LocationName" class="text-danger"></span>

            </div>
                <div class="form-group">
                    <label asp-for="UserName" class="control-label fw-bold"></label>
                    <input asp-for="UserName" class="form-control" name="UserName" />
                    <span asp-validation-for="UserName" class="text-danger"></span>

                </div>
                <div class="form-group">
                    <label asp-for="Password" class="control-label fw-bold"></label>
                    <input asp-for="Password" class="form-control" name="Password" />
                    <span asp-validation-for="Password" class="text-danger"></span>

                </div>
                <div class="form-group">
                    <label>Upload Photo</label>
                    <input asp-for="RestaurantImage" type="file" class="form-control" name="RestaurantImage" />
                </div>
           
                <p>@TempData["Message"]</p>
            <div class="form-group">
                <input type="submit" value="Add" class="btn btn-primary btn-lg mt-2" />
            </div>
           
        </form>
    </div>
</div>
</div>



