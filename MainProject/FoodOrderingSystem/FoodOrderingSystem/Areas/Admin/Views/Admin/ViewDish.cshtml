@model IEnumerable<FoodOrderingSystem.Models.Dish>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "View Dishes";
    Layout = "~/Areas/Admin/Views/Shared/_HotelMngrDashboard.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet" />

<style>
    body {
        background-color: #f8f9fa;
    }

    .dish-card {
        border: none;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        background-color: #fff;
    }

        .dish-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.15);
        }

    .dish-img {
        width: 100%;
        height: 240px;
        object-fit: cover;
    }

    .dish-name {
        font-size: 1.5rem;
        font-weight: 700;
        color: #212529;
        text-align: center;
        margin-top: 12px;
        margin-bottom: 6px;
    }

    .dish-details {
        font-size: 0.95rem;
        color: #6c757d;
        padding: 0 16px 12px;
        text-align: center;
    }

    .card-footer {
        background-color: #f8f9fa;
        border-top: 1px solid #e9ecef;
        padding: 10px 16px;
        display: flex;
        justify-content: center;
        gap: 10px;
    }

        .card-footer .btn {
            transition: all 0.3s ease;
        }

            .card-footer .btn:hover {
                transform: scale(1.05);
            }

    .top-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }
</style>

@functions {
    public string GetCategoryColor(string category)
    {
        return category switch
        {
            "Starter" => "primary",
            "Main Course" => "success",
            "Dessert" => "danger",
            _ => "secondary"
        };
    }
}

<section style="background-color:#f4f4f4; padding: 40px 0;">
    <div class="container mt-4">
        <div class="top-actions">
            <h2 class="mb-0">🍽️ Dishes List</h2>
            <a asp-action="AddDish" class="btn btn-outline-success shadow-sm px-4 py-2 rounded-pill">
                <i class="bi bi-plus-circle"></i> Add New Dish
            </a>
        </div>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="dish-card">
                        <img src="@Url.Content("~/" + item.ImagePath)" alt="@item.DishName" class="dish-img" />
                        <div class="p-3">
                            <div class="dish-name">@item.DishName</div>
                            <div class="dish-details">
                                ₹@item.Price | @item.Availablity <br />
                                <span class="badge bg-@GetCategoryColor(item.Category.ToString())">@item.Category</span>
                            </div>
                        </div>
                        <div class="card-footer">
                            <a asp-action="Edit" asp-route-id="@item.DishId" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil-square"></i> Edit
                            </a>
                            <a asp-action="Details" asp-route-id="@item.DishId" class="btn btn-sm btn-outline-info">
                                <i class="bi bi-info-circle"></i> Details
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.DishId" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
