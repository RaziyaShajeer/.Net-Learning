@model IEnumerable<FoodOrderingSystem.Models.Dish>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "View Dishes";
    Layout = "~/Areas/Admin/Views/Shared/_HotelMngrDashboard.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    .dish-card {
        border: none;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        background-color: #fff;
    }

        .dish-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.15);
        }

    .dish-img {
        width: 100%;
        height: 240px;
        object-fit: cover;
    }

    .dish-name {
        font-size: 1.5rem;
        font-weight: 700;
        color: #212529;
        text-align: center;
        margin-top: 12px;
        margin-bottom: 6px;
    }

    .dish-details {
        font-size: 0.9rem;
        color: #6c757d;
        padding: 0 16px 12px;
        text-align: center;
    }

    .card-footer {
        background-color: #f8f9fa;
        border-top: 1px solid #e9ecef;
        padding: 10px 16px;
        display: flex;
        justify-content: center;
        gap: 10px;
    }

    .top-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }
</style>

<div class="container mt-4 ml-3">
    <div class="top-actions">
        <h2 class="mb-0">🍽️ Dishes List</h2>
        <a asp-action="AddDish" class="btn btn-success">➕ Add New Dish</a>
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="dish-card">
                    <div class="student-card">
                        <img src="@Url.Content("~/" + item.ImagePath)" alt="Student Image" width="100" height="100" />
                        <div>@item.DishName</div>
                    </div>
                    <div class="dish-name">@item.DishName</div>
                    <div class="dish-details">
                        ₹@item.Price | @item.Availablity <br />
                        @item.Category 
                    </div>
                    <div class="card-footer">
                        <a asp-action="Edit" asp-route-id="@item.DishId" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.DishId" class="btn btn-sm btn-outline-info">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.DishId" class="btn btn-sm btn-outline-danger">Delete</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
